    "secretMinNeighbors": 3,
    "maxAttempts": 5000
  },
  "difficulty": {
    // Enemy points per room by distance from the start (rooms).
    "budget": [ { "upTo": 2, "points": 4 }, { "upTo": 4, "points": 6 }, { "upTo": 99, "points": 8 } ],
