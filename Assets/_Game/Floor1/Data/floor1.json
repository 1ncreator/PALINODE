{
  // ================================================================ PALINODE — Floor I "The Press": balance & layout
  // All numbers are starting values for playtesting. Units: 1 cell = 1 world unit horizontally ("cells/s" speeds);
  // a cell's height on screen comes from each background's calibration (3/4 view, ~0.75).
  // Localized texts live in Prologue/Data/localization.csv (keys F1_*).

  "scene": "Floor1",
  "chapter": 1,
  "seed": 0,                       // 0 = random each run; any other value = fixed floor (debugging)

  // ortho: half the visible height in cells (4.75 = a whole ordinary room on a 16:9 screen); bossOrtho for the arena.
  // bossBias: how far the arena view is pulled from Elias toward the press (0 = follow Elias, 1 = look at the press).
  "camera": { "ortho": 4.75, "bossOrtho": 6.8, "bossBias": 0.45, "slide": 0.32, "follow": 7.0, "background": "#050404" },

  // ---------------------------------------------------------------- Elias
  "player": {
    "halves": 6,                   // start health: 3 ink drops = 6 halves
    "maxDrops": 12,                // containers cap
    "damage": 3.5,
    "fireRate": 2.7,               // shots per second
    "range": 6.5,                  // cells
    "shotSpeed": 8.0,              // cells/s
    "inherit": 0.3,                // part of Elias's velocity added to a shot
    "speed": 4.5,                  // cells/s
    "accel": 38, "decel": 30,      // inertia (cells/s²)
    "iframes": 1.0,                // invulnerability after a hit (s), blinking
    "knockback": 5.0,
    "radius": 0.3,                 // feet circle (cells)
    "width": 1.05,                 // sprite width on screen (cells)
    "shootPose": 0.2,              // shooting pose after each shot (s)
    "poseHeight": 2.15,            // on-screen height of the shooting poses (cells)
    "pickupHeight": 2.45,          // on-screen height of the "item over the head" pose
    "fallenWidth": 2.3,            // width of the struck-out body
    "shotHeight": 0.95,            // the drop flies this high above its shadow (cells)
    "cycle": 1.35,                 // cells walked per full walk cycle (feet never slide)
    "lightRadius": 4.0,            // dark rooms: visible circle (cells)
    "walk": {
      "blend": 0.5,
      "down":  { "prefix": "G_walk_down_",  "count": 8, "idle": 2, "plants": [0, 4] },
      "up":    { "prefix": "G_walk_up_",    "count": 8, "idle": 3, "plants": [1, 5] },
      "right": { "prefix": "G_walk_right_", "count": 8, "idle": 2, "plants": [3, 7] }
    },
    "shoot": { "down": "F1_shoot_down", "up": "F1_shoot_up", "left": "F1_shoot_left", "right": "F1_shoot_right" },
    "footsteps": "SFX_footsteps_wet", "footstepVolume": 0.18
  },

  // ---------------------------------------------------------------- floor structure
  "generation": {
    "grid": [9, 8],
    "rooms": [9, 12],              // rooms of the floor (without the secret one)
    "combat": [6, 9],
    "reject": 0.5,
