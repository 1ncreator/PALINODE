// PALINODE — prologue script. Everything the player sees and hears in the prologue is described here.
//
// Units: "pos"/camera x,y are 1920×1080 reference pixels from the screen centre (y up);
//        "px" are pixels of the parent layer's image (top-left origin); times are seconds.
// Layer types: sprite (default), rect, page, phone, clock, text, light, rain, dust, shaderQuad, glow, empty.
// Every step: {"type": ...}; add "async": true to let the next step start immediately, "delay": s to wait first.
// Full list of step types: see Assets/_Game/Scripts/Cutscene/Steps.cs.
{
  "menuScene": "Menu",
  "menu": { "music": { "clip": "MUS_menu", "lufs": -22, "fade": 3.0 } },
  "exitScene": "Floor1",   // Floor I "The Press" (Floor1/Data/floor1.json)

  // Mix. Any sfx/loop/music/vo step (and chapter ambience/music) may use "lufs": <target> instead of "volume":
  // the volume is then computed from the measured loudness of the clip (Data/audio_levels.json).
  //   voiceLufs     target loudness of every voice line
  //   voiceDuckDb   automatic dip of music + ambience while a voice line plays (side-chain)
  "mix": { "voiceLufs": -22, "voiceDuckDb": -7, "voiceDuckAttack": 0.15, "voiceDuckRelease": 0.7 },
  "flow": ["scene1", "scene2", "scene3", "scene4", "scene5", "scene6", "scene7", "title"],

  "chapters": {

    // ===================================================================== SCENE 1 — the study, ~50 s
    // Music (Suno cues cut/levelled by Data/audio_processing.json): MUS_scene1_night enters under P1-02 very quietly and
    // rises with each rewritten line (targets in LUFS; volumes are computed from Data/audio_levels.json).
    // "loop": false = a through-composed cue that ends on its own fade-out.
    "scene1": {
      "scene": "Prologue_Cinematic",
      "ambience": [ { "id": "tick", "clip": "SFX_clock_tick_n", "lufs": -41, "fade": 1.0 } ],
      "imprint": 0,
      "steps": [
        // P1-01 — 5 s of black (storyboard): ticking, paper, a pen scratching somewhere in the dark.
        { "type": "wait", "time": 1.0 },
        { "type": "sfx", "clip": "SFX_paper_rustle", "lufs": -37 },
        { "type": "wait", "time": 1.4 },
        { "type": "sfx", "clip": "SFX_pen_write_n", "id": "pen0", "lufs": -38 },
        { "type": "wait", "time": 2.6 },
        { "type": "stopSfx", "id": "pen0", "fade": 0.8 },

        // P1-02 — Elias at the desk, slow push-in (8 s), hand-held drift, lamp flicker, dust in the beam.
        { "type": "shot", "layers": [
          { "id": "bg", "sprite": "P1-02_bg", "depth": 0.92 },
          { "id": "wallclock", "type": "clock", "parent": "bg", "px": [575, 122], "order": 2,
            "hour": "PR_wallclock_hour", "minute": "PR_wallclock_minute", "hourLen": 30, "minuteLen": 45,
            "squash": [0.84, 1.0], "time": "03:08", "handTint": "#b8aa98" },
          { "id": "rainOutside", "type": "rain", "parent": "bg", "px": [1226, 250], "size": [620, 500], "order": 1,
            "rate": 220, "speed": 5.5, "angle": 5, "length": 0.22, "width": 0.7, "color": "#aab6cc55" },
          { "id": "rainGlass", "type": "shaderQuad", "shader": "RainGlass", "parent": "bg", "px": [1226, 250], "size": [620, 500],
            "order": 3, "color": "#ffffff99", "props": { "_Density": 3.2, "_Speed": 0.25, "_Haze": 0.03 } },
          { "id": "elias", "sprite": "P1-02_elias", "parent": "bg", "px": [726, 645], "scale": 0.67, "order": 5 },
          { "id": "lamp", "type": "light", "parent": "bg", "px": [700, 402], "order": 6,
            "color": "#ffc98a", "intensity": 0.55, "radius": 460, "falloff": 0.55, "flicker": 0.12 },
          { "id": "lampGlow", "type": "glow", "parent": "bg", "px": [700, 404], "size": [170, 110], "order": 4, "color": "#ffd9a050" },
          { "id": "dust", "type": "dust", "parent": "bg", "px": [640, 470], "size": [260, 200], "order": 8, "rate": 6, "sizeMul": 1.8, "color": "#ffdcaa26" }
        ] },
        { "type": "handheld", "px": 5, "rot": 0.18, "speed": 0.3 },
        { "type": "loop", "id": "rain", "clip": "SFX_rain_window", "lufs": -37, "fade": 3.0 },
        { "type": "music", "clip": "MUS_scene1_night", "loop": false, "lufs": -28, "fade": 7.0 },
        { "type": "fade", "to": "clear", "duration": 2.5, "async": true },
        { "type": "camera", "zoom": 1.12, "x": -60, "y": 35, "duration": 8.0, "async": true },
        { "type": "wait", "time": 3.2 },
        { "type": "flicker", "light": "lamp", "duration": 0.9, "strength": 0.55, "async": true },
        { "type": "wait", "time": 2.2 },
        { "type": "marker", "id": "P1-02" },
        { "type": "wait", "time": 2.6 },

        // P1-03 — the page. The hand enters from under the frame edge; write → pause → strike, three times.
        // The camera follows the line being written (close → closer), cutaways: tired face, the wall clock.
        { "type": "shot", "fade": 1.0, "layers": [
          { "id": "desk", "sprite": "P1-03_desk" },
          { "id": "page", "type": "page", "parent": "desk", "px": [733, 512], "rot": 2.0, "size": [480, 580],
            "top": 62, "left": 30, "lineHeight": 66, "fontPx": 40, "order": 2, "font": "hand_bad",
            "ink": { "pressure": 0.14, "bleed": 0.07, "bleedAlpha": 0.22, "rim": 0.35 } },
          { "id": "hand", "sprite": "P1-03_hand_pen", "parent": "desk", "px": [1010, 880], "scale": 0.44, "rig": true,
            "enter": [520, 360], "enterTime": 1.4, "order": 10 },
          { "id": "deskLamp", "type": "light", "parent": "desk", "px": [330, 150], "color": "#ffc98a", "intensity": 0.35, "radius": 700, "falloff": 0.7, "flicker": 0.06 },
          { "id": "deskDust", "type": "dust", "parent": "desk", "px": [520, 330], "size": [600, 420], "order": 20, "rate": 5, "sizeMul": 1.4, "color": "#ffdcaa1e" }
        ], "camera": { "zoom": 1.0, "x": -40, "y": 60 } },
        { "type": "musicLevel", "lufs": -26, "duration": 4 },
        { "type": "camera", "zoom": 1.14, "x": -40, "y": 190, "duration": 3.0, "ease": "inOutSine", "async": true },
        { "type": "handTo", "hand": "hand", "page": "page", "line": 0, "offset": [150, -20], "duration": 1.4, "smooth": 0.35 },
        { "type": "sfx", "clip": "SFX_pen_write_n", "id": "pen", "lufs": -35 },
        { "type": "marker", "id": "seq_hand_title|crop=520,160,880,495|n=12|dt=0.08", "delay": 0.8, "async": true },
        { "type": "write", "page": "page", "line": 0, "key": "PAGE_TITLE", "align": "center", "fontScale": 1.3, "cps": 8, "hand": "hand" },
        { "type": "write", "page": "page", "line": 1, "key": "PAGE_THEN_SHE", "cps": 9, "hand": "hand" },
        { "type": "stopSfx", "id": "pen", "fade": 0.3 },
        { "type": "wait", "time": 1.0 },
        { "type": "strike", "page": "page", "line": 1, "duration": 0.6, "hand": "hand", "sfx": "SFX_pen_strike", "lufs": -30 },
        { "type": "camera", "zoom": 1.2, "x": -30, "y": 140, "duration": 2.0, "async": true },
        { "type": "wait", "time": 0.6 },

        // 1) MARA DIED ON AUGUST 17, 2017.
        { "type": "sfx", "clip": "SFX_pen_write_n", "id": "pen", "lufs": -35 },
        { "type": "marker", "id": "seq_hand_write|crop=520,300,880,495|n=12|dt=0.08", "delay": 1.0, "async": true },
        { "type": "write", "page": "page", "line": 2, "key": "PAGE_L1", "cps": 11, "hand": "hand" },
        { "type": "stopSfx", "id": "pen", "fade": 0.3 },
        { "type": "wait", "time": 1.5 },
        { "type": "show", "fade": 0.35, "layer": { "id": "tiredInsert", "sprite": "P1-04_face_tired", "order": 50, "scale": 1.04 } },
        { "type": "move", "id": "tiredInsert", "scaleMul": 1.04, "duration": 2.5, "async": true },
        { "type": "wait", "time": 2.5 },
        { "type": "hide", "id": "tiredInsert", "fade": 0.35 },
        { "type": "marker", "id": "seq_hand_strike|crop=520,300,880,495|n=10|dt=0.08", "delay": 0.3, "async": true },
        { "type": "strike", "page": "page", "line": 2, "duration": 0.75, "hand": "hand", "sfx": "SFX_pen_strike", "lufs": -30 },
        { "type": "camera", "zoom": 1.22, "x": -30, "y": 100, "duration": 2.0, "async": true },
        { "type": "musicLevel", "lufs": -24, "duration": 3 },
        { "type": "wait", "time": 0.5 },

        // 2) MARA DIED IN AN ACCIDENT.
        { "type": "sfx", "clip": "SFX_pen_write_n", "id": "pen", "lufs": -35 },
        { "type": "write", "page": "page", "line": 3, "key": "PAGE_L2", "cps": 11, "hand": "hand" },
        { "type": "stopSfx", "id": "pen", "fade": 0.3 },
        // Cutaway to the wall clock: 03:09, the tick in the foreground.
        { "type": "show", "fade": 0.25, "layers": [
          { "id": "clockInsert", "sprite": "P1-02_bg", "scale": 3.0, "pos": [723, -1462], "order": 60 },
          { "id": "clockInsertHands", "type": "clock", "parent": "clockInsert", "px": [575, 122], "order": 61,
            "hour": "PR_wallclock_hour", "minute": "PR_wallclock_minute", "hourLen": 30, "minuteLen": 45,
            "squash": [0.84, 1.0], "time": "03:09", "handTint": "#b8aa98" }
        ] },
        { "type": "loopVolume", "id": "tick", "clip": "SFX_clock_tick_n", "lufs": -33, "duration": 0.3 },
        { "type": "move", "id": "clockInsert", "scaleMul": 1.03, "duration": 1.5, "async": true },
        { "type": "wait", "time": 1.3 },
        { "type": "hide", "ids": ["clockInsert"], "fade": 0.25 },
        { "type": "loopVolume", "id": "tick", "clip": "SFX_clock_tick_n", "lufs": -41, "duration": 0.6 },
        { "type": "strike", "page": "page", "line": 3, "duration": 0.7, "hand": "hand", "sfx": "SFX_pen_strike", "lufs": -30 },
        { "type": "camera", "zoom": 1.26, "x": -30, "y": 60, "duration": 2.0, "async": true },
        { "type": "musicLevel", "lufs": -22, "duration": 3 },
        { "type": "wait", "time": 0.5 },

        // 3) MARA WAS KILLED BY A TRUCK DRIVER. — not struck
        { "type": "sfx", "clip": "SFX_pen_write_n", "id": "pen", "lufs": -35 },
        { "type": "write", "page": "page", "line": 4, "key": "PAGE_L3", "cps": 11, "hand": "hand" },
        { "type": "stopSfx", "id": "pen", "fade": 0.3 },
        { "type": "camera", "zoom": 1.1, "x": -40, "y": 90, "duration": 2.2, "async": true },
        { "type": "wait", "time": 1.5 },
        { "type": "handTo", "hand": "hand", "layer": "desk", "px": [1060, 900], "duration": 1.2, "smooth": 0.45 },
        { "type": "marker", "id": "P1-03_lines" },
        { "type": "wait", "time": 0.6 },

        // P1-04 — the chair creaks, tiredness gives way to relief; the music opens up.
        { "type": "sfx", "clip": "SFX_chair_creak", "lufs": -27 },
        { "type": "shot", "fade": 0.8, "layers": [ { "id": "faceTired", "sprite": "P1-04_face_tired" } ], "camera": { "zoom": 1.0 } },
        { "type": "musicLevel", "lufs": -19, "duration": 3 },
        { "type": "camera", "zoom": 1.07, "y": 20, "duration": 5.0, "async": true },
        { "type": "wait", "time": 0.8 },
        { "type": "show", "fade": 2.0, "layer": { "id": "faceRelief", "sprite": "P1-04_face_relief", "order": 2 } },
        { "type": "marker", "id": "P1-04" },
        { "type": "wait", "time": 1.6 },
        { "type": "fade", "to": "black", "duration": 1.2 }
      ]
    },

    // ===================================================================== SCENE 2 — the call and the photo, ~42 s
    "scene2": {
      "scene": "Prologue_Cinematic",
      "ambience": [
        { "id": "tick", "clip": "SFX_clock_tick_n", "lufs": -41 },
        { "id": "rain", "clip": "SFX_rain_window", "lufs": -37 }
      ],
      "music": { "clip": "MUS_scene2_call", "loop": false, "lufs": -26, "fade": 2.0 },   // its first swell is cut to land on the photo (P2-05)
      "imprint": 0,
      "steps": [
        // P2-01 — the phone on the desk lights up: MARA (6 s). The vibration is the loudest thing in the room.
        { "type": "shot", "layers": [
          { "id": "desk", "sprite": "P1-03_desk" },
          { "id": "page", "type": "page", "parent": "desk", "px": [733, 512], "rot": 2.0, "size": [480, 580],
            "top": 62, "left": 30, "lineHeight": 66, "fontPx": 40, "order": 2, "font": "hand_bad" },
          { "id": "phone", "sprite": "PR_phone_on", "parent": "desk", "px": [1175, 585], "scale": 0.36, "rot": -6, "order": 6 },
          { "id": "call", "type": "phone", "parent": "phone", "px": [376, 370], "rot": 30.5, "size": [255, 520], "fontPx": 26, "order": 7 },
          { "id": "screenLight", "type": "light", "parent": "phone", "px": [376, 370], "color": "#a8c2ff", "intensity": 0.95, "radius": 1500, "falloff": 0.75 },
          { "id": "deskLamp", "type": "light", "parent": "desk", "px": [330, 150], "color": "#ffc98a", "intensity": 0.25, "radius": 700, "falloff": 0.7 }
        ], "camera": { "zoom": 1.0, "x": -60, "y": 40 } },
        { "type": "handheld", "px": 4, "rot": 0.15, "speed": 0.3 },
        { "type": "preset", "page": "page", "line": 0, "key": "PAGE_TITLE", "align": "center", "fontScale": 1.3 },
        { "type": "preset", "page": "page", "line": 1, "key": "PAGE_THEN_SHE", "struck": true },
        { "type": "preset", "page": "page", "line": 2, "key": "PAGE_L1", "struck": true },
        { "type": "preset", "page": "page", "line": 3, "key": "PAGE_L2", "struck": true },
        { "type": "preset", "page": "page", "line": 4, "key": "PAGE_L3" },
        { "type": "globalLight", "intensity": 0.75 },
        { "type": "phoneCall", "phone": "call", "key": "CALLER_MARA", "subKey": "CALLER_INCOMING", "async": true },
        { "type": "fade", "to": "clear", "duration": 1.2, "async": true },
        { "type": "camera", "zoom": 1.16, "x": 120, "y": -20, "duration": 6.0, "async": true },
        { "type": "wait", "time": 0.8 },
        // While it buzzes everything else steps back (duck), so the buzz is heard even on laptop speakers.
        { "type": "duck", "level": 0.35, "duration": 0.15 },
        { "type": "sfx", "clip": "SFX_phone_vibrate_desk", "lufs": -24 },
        { "type": "mix", "id": "vibrate_1", "delay": 0.8, "async": true },
        { "type": "vibrate", "id": "phone", "duration": 1.1, "amplitude": 5 },
        { "type": "wait", "time": 0.7 },
        { "type": "sfx", "clip": "SFX_phone_vibrate_desk", "lufs": -24 },
        { "type": "vibrate", "id": "phone", "duration": 1.1, "amplitude": 5 },
        { "type": "marker", "id": "P2-01" },
        { "type": "duck", "level": 0.6, "duration": 0.8 },
        { "type": "wait", "time": 1.4 },

        // P2-02 — his face in the cold light (4 s)
        { "type": "shot", "fade": 0.5, "layers": [ { "id": "face", "sprite": "P2-02_face_phone" } ] },
        { "type": "globalLight", "intensity": 1.0 },
        { "type": "duck", "level": 1.0, "duration": 1.5 },
        { "type": "musicLevel", "lufs": -24, "duration": 3 },
        { "type": "camera", "zoom": 1.08, "y": 20, "duration": 4.0, "async": true },
        { "type": "wait", "time": 1.6 },
        { "type": "marker", "id": "P2-02" },
        { "type": "wait", "time": 2.0 },

        // P2-03 — messages, one by one (~10 s). The music rises with each message.
        { "type": "shot", "fade": 0.4, "layers": [
          { "id": "hp", "sprite": "P2-03_hand_phone" },
          { "id": "chat", "type": "phone", "parent": "hp", "px": [801, 466], "rot": -12.5, "size": [146, 386], "fontPx": 13, "order": 3 }
        ], "camera": { "x": 40, "y": 52, "zoom": 1.55 } },
        { "type": "phoneHeader", "phone": "chat", "key": "CALLER_MARA" },
        { "type": "camera", "x": 40, "y": 60, "zoom": 1.8, "duration": 10.0, "async": true },
        { "type": "wait", "time": 1.0 },
        { "type": "phoneMessage", "phone": "chat", "key": "MSG_1", "sfx": "SFX_phone_message", "lufs": -26 },
        { "type": "musicLevel", "lufs": -22, "duration": 2 },
        { "type": "wait", "time": 2.2 },
        { "type": "phoneMessage", "phone": "chat", "key": "MSG_2", "sfx": "SFX_phone_message", "lufs": -26 },
        { "type": "musicLevel", "lufs": -20, "duration": 3 },
        { "type": "shake", "amplitude": 2, "duration": 0.35, "async": true },
        { "type": "wait", "time": 3.0 },
        { "type": "phoneMessage", "phone": "chat", "key": "MSG_3", "sfx": "SFX_phone_message", "lufs": -26 },
        { "type": "wait", "time": 1.2 },
        { "type": "marker", "id": "P2-03" },
        { "type": "wait", "time": 1.2 },

        // P2-04 — the wall: the empty frame now holds the photo; he walks up to it. Clock at 03:10.
        // Walk: 8-frame cycle (ArtInbox/walk_P2-04), entering from the right and shrinking with depth towards the frame;
        // it slows down with the ease and stops on a near-standing frame ("walk" step, see Steps.cs).
        { "type": "shot", "fade": 1.0, "layers": [
          { "id": "wall", "sprite": "P2-04_wall" },
          { "id": "framePhoto", "sprite": "P2-05_print_portrait", "parent": "wall", "px": [877, 439], "scale": 0.324, "order": 2, "tint": "#8f857a" },
          { "id": "wallclock", "type": "clock", "parent": "wall", "px": [1335, 215], "order": 3,
            "hour": "PR_wallclock_hour", "minute": "PR_wallclock_minute", "hourLen": 72, "minuteLen": 108,
            "squash": [0.93, 1.0], "time": "03:10", "handTint": "#c8baa6" },
          { "id": "eliasBack", "sprite": "P2-04_walk_01", "parent": "wall", "px": [1760, 1450], "scale": 0.8, "order": 8 },
          { "id": "warm", "type": "light", "parent": "wall", "px": [60, 600], "color": "#ffbe7a", "intensity": 0.35, "radius": 900, "falloff": 0.8 }
        ] },
        { "type": "camera", "zoom": 1.08, "x": 40, "duration": 6.0, "async": true },
        { "type": "marker", "id": "P2-04", "delay": 1.8, "async": true },
        { "type": "marker", "id": "seq_P2-04_walk|crop=480,0,1440,1080|n=12|dt=0.08", "delay": 2.2, "async": true },
        { "type": "walk", "id": "eliasBack", "frames": { "prefix": "P2-04_walk_", "count": 8, "idle": 5, "plants": [3, 7] },
          "px": [1150, 1290], "scale": 0.7, "perspective": true, "duration": 4.2, "ease": "outSine", "cycleTime": 1.15, "blend": 0.35 },
        { "type": "wait", "time": 1.2 },

        // P2-05 — the photo, slow push (4 s): the musical peak of the scene.
        { "type": "shot", "fade": 0.8, "layers": [ { "id": "photo", "sprite": "P2-05_photo" } ] },
        { "type": "musicLevel", "lufs": -18, "duration": 3 },
        { "type": "marker", "id": "P2-05", "delay": 2.0, "async": true },
        { "type": "camera", "zoom": 1.16, "x": 30, "y": 40, "duration": 4.0, "ease": "inOutSine" },

        // P2-06 — the back of the photo: a date; his finger follows it. Then the phone buzzes again.
        { "type": "sfx", "clip": "SFX_photo_flip", "lufs": -28 },
        { "type": "shot", "fade": 0.25, "layers": [
          { "id": "back", "sprite": "P2-06_photo_back" },
          { "id": "date", "type": "page", "parent": "back", "px": [770, 600], "rot": 3.5, "size": [760, 240],
            "top": 110, "left": 0, "lineHeight": 140, "fontPx": 104, "color": "#2b2521d8", "order": 2, "font": "hand_bad" },
          { "id": "finger", "sprite": "P2-06_hand", "parent": "back", "px": [1045, 897], "scale": 0.72, "rig": true,
            "enter": [420, 380], "enterTime": 1.2, "liftPx": 6, "shadowAlpha": 0.28, "order": 5 }
        ] },
        { "type": "musicLevel", "lufs": -21, "duration": 2 },
        { "type": "preset", "page": "date", "line": 0, "key": "PHOTO_DATE", "align": "center" },
        { "type": "camera", "zoom": 1.08, "x": -20, "duration": 7.0, "async": true },
        { "type": "handTo", "hand": "finger", "page": "date", "line": 0, "at": "start", "offset": [-10, -30], "duration": 1.6, "smooth": 0.6, "contact": true },
        { "type": "handTo", "hand": "finger", "page": "date", "line": 0, "at": "end", "offset": [0, -30], "duration": 3.2, "smooth": 1.1 },
        { "type": "marker", "id": "P2-06" },
        { "type": "duck", "level": 0.35, "duration": 0.15 },
        { "type": "sfx", "clip": "SFX_phone_vibrate_desk", "lufs": -24 },
        { "type": "mix", "id": "vibrate_2", "delay": 0.6, "async": true },
        { "type": "wait", "time": 0.8 },
        { "type": "shot", "fade": 0.4, "layers": [
          { "id": "hp", "sprite": "P2-03_hand_phone" },
          { "id": "chat", "type": "phone", "parent": "hp", "px": [801, 466], "rot": -12.5, "size": [146, 386], "fontPx": 13, "order": 3 }
        ], "camera": { "x": 40, "y": 60, "zoom": 1.8 } },
        { "type": "duck", "level": 1.0, "duration": 1.0 },
        { "type": "phoneHeader", "phone": "chat", "key": "CALLER_MARA" },
        { "type": "phoneMessage", "phone": "chat", "key": "MSG_1", "async": true },
        { "type": "phoneMessage", "phone": "chat", "key": "MSG_2", "async": true },
